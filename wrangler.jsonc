// Cloudflare Worker configuration for the Neuropulse Inc. website.
// Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "neuropulse-inc",
  "main": "src/server/index.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // `npm run build` assembles src/client into public/ before every dev/deploy.
  "build": { "command": "node scripts/build.mjs" },

  // Static files (HTML, CSS, JS, images) are served straight from Cloudflare's edge.
  // Only /api/* reaches the Worker code, which keeps the free-plan request budget for real work.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // /work/* lets the Worker render each project's case-study page (/work/<slug>).
    "run_worker_first": ["/api/*", "/media/*", "/work/*"]
  },

  // D1 (SQLite at the edge). The site's code uses the binding name "DB": keep exactly one entry.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "neuropulse-db",
      "database_id": "f22aca58-b1c6-454d-ac2a-f04880c1c56f",
      "migrations_dir": "migrations"
    }
  ],

  // Uploaded project screenshots are served publicly from this bucket.
  "r2_buckets": [
    {
      "binding": "PROJECT_IMAGES",
      "bucket_name": "neuropulse-project-images"
    }
  ],

  // Daily housekeeping at 02:00 SAST: deletes expired sessions and old rate-limit rows, and applies the
  // 24-month retention rule from the privacy policy (old enquiries, call bookings and audit entries).
  "triggers": { "crons": ["0 0 * * *"] },

  // Non-secret settings. Secrets (RESEND_API_KEY, TURNSTILE_SECRET_KEY, IP_SALT) go in
  // `npx wrangler secret put NAME` for production, or .dev.vars locally.
  "vars": {
    "SITE_NAME": "Neuropulse Inc.",
    "SITE_URL": "https://neuropulse-inc.workers.dev",
    "NOTIFY_EMAIL": "neuropulse.inc@gmail.com",
    // While this is the Resend test sender, only YOUR inbox receives mail: owner alerts work, but the
    // automatic replies and call confirmations to visitors are skipped. After verifying your domain in
    // Resend, change it to e.g. "Neuropulse <hello@neuropulseinc.com>" (see docs/DEPLOYMENT.md).
    "MAIL_FROM": "Neuropulse Website <onboarding@resend.dev>",
    "TURNSTILE_SITE_KEY": "",
    // Used in emails sent to visitors.
    "WHATSAPP_URL": "https://wa.me/27727216200",
    "PHONE_DISPLAY": "072 721 6200",
    // Days with no discovery calls, e.g. public holidays: "2026-12-16,2026-12-25,2026-12-26". Hours are in src/server/lib/booking.js.
    "BOOKING_BLOCKED_DATES": "2026-12-16,2026-12-25,2026-12-26"
  },

  "observability": { "enabled": true }
}